# PostgreSQL: runtime role (daemon), migrations role (owner), and web panel role (read-only)
UNICODE_DATABASE_URL=postgresql://unicode_daemon:unicode_daemon@localhost:5432/unicode
UNICODE_MIGRATIONS_DATABASE_URL=postgresql://unicode_owner:unicode_owner@localhost:5432/unicode
UNICODE_PANEL_DATABASE_URL=postgresql://unicode_panel:unicode_panel@localhost:5432/unicode

# Connection pool size used by the daemon
UNICODE_DB_POOL_MIN_SIZE=1
UNICODE_DB_POOL_MAX_SIZE=10

# Directories for questions and student workspaces
UNICODE_QUESTIONS_DIR=questions
UNICODE_WORKSPACES_DIR=/srv/unicode/workspaces

# Unix socket path for the daemon
UNICODE_DAEMON_SOCKET_PATH=/run/unicode/daemon.sock

# Admin web panel credentials and static build directory
UNICODE_ADMIN_EMAIL=admin@unicode.local
UNICODE_ADMIN_PASSWORD=change-me-in-prod
UNICODE_WEB_DIST_DIR=web/dist
